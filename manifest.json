{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "/",
  "name": "Light Kali — First Cybersecurity Web OS from Iran",
  "short_name": "Light Kali",
  "description": "Light Kali (LightKali, Kali Light) — the first Web OS from Iran. A lightweight Linux-based cybersecurity platform with web-first interface, modular packages, security workflows, developer tools, and an extensible open web environment.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "theme_color": "#050505",
  "background_color": "#050505",
  "prefer_related_applications": false,
  "categories": ["education", "security", "developer", "productivity", "utilities"],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "handle_links": "preferred",
  "screenshots": [
    {
      "src": "/assets/screenshots/light-kali-desktop-1.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Light Kali Web OS desktop interface"
    },
    {
      "src": "/assets/screenshots/light-kali-mobile-1.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Light Kali Web OS mobile interface"
    }
  ],
  "icons": [
    {
      "src": "/assets/icons/light-kali.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/icons/light-kali-monochrome.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "monochrome"
    },
    {
      "src": "/assets/icons/light-kali-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icons/light-kali-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Launch Light Kali Web OS",
      "short_name": "Launch",
      "description": "Launch the Light Kali cybersecurity Web OS application",
      "url": "/app/",
      "icons": [
        {
          "src": "/assets/icons/light-kali-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Light Kali Home",
      "short_name": "Home",
      "description": "Return to Light Kali homepage",
      "url": "/",
      "icons": [
        {
          "src": "/assets/icons/light-kali-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Read Light Kali Documentation",
      "short_name": "Docs",
      "description": "Access Light Kali documentation, Linux basics, and Web OS guides",
      "url": "/docs.html",
      "icons": [
        {
          "src": "/assets/icons/light-kali-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Explore Light Kali Packages",
      "short_name": "Packages",
      "description": "Browse the modular Light Kali package ecosystem",
      "url": "/packages.html",
      "icons": [
        {
          "src": "/assets/icons/light-kali-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Light Kali Developer Center",
      "short_name": "Developers",
      "description": "Developer resources, APIs, and package development tools",
      "url": "/developer.html",
      "icons": [
        {
          "src": "/assets/icons/light-kali-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "About Light Kali",
      "short_name": "About",
      "description": "Learn about the first Web OS from Iran",
      "url": "/about/",
      "icons": [
        {
          "src": "/assets/icons/light-kali-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Light Kali Wallpapers",
      "short_name": "Wallpapers",
      "description": "Browse Light Kali wallpaper collection",
      "url": "/wallpapers/",
      "icons": [
        {
          "src": "/assets/icons/light-kali-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Light Kali FAQ",
      "short_name": "FAQ",
      "description": "Frequently asked questions about Light Kali",
      "url": "/#faq",
      "icons": [
        {
          "src": "/assets/icons/light-kali-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Official Telegram Channel",
      "short_name": "Telegram",
      "description": "Follow Light Kali news on Telegram",
      "url": "https://t.me/LightKali",
      "icons": [
        {
          "src": "/assets/icons/light-kali-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/app/",
      "accept": {
        "text/*": [".txt", ".md"],
        "application/json": [".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+lightkali",
      "url": "/app/?uri=%s"
    }
  ],
  "related_applications": []
    }
