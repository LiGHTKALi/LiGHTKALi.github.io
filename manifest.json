{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "/",
  "name": "Light Kali — Cybersecurity Web OS",
  "short_name": "Light Kali",
  "description": "Light Kali is a lightweight Linux-based cybersecurity Web OS project with a web-first interface, modular packages, practical security workflows, developer resources, and an extensible open web environment. Also known as LightKali and Kali Light.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "theme_color": "#050505",
  "background_color": "#050505",
  "prefer_related_applications": false,
  "categories": [
    "development",
    "education",
    "utilities",
    "productivity",
    "security"
  ],
  "icons": [
    {
      "src": "/assets/icons/light-kali.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/light-kali-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icons/light-kali-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icons/light-kali-monochrome.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "monochrome"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Light Kali",
      "short_name": "Light Kali",
      "description": "Open the main Light Kali Web OS project page.",
      "url": "/"
    },
    {
      "name": "Try Light Kali",
      "short_name": "Try",
      "description": "Open the Light Kali Web OS application.",
      "url": "/app/"
    },
    {
      "name": "Developer Center",
      "short_name": "Developers",
      "description": "Explore Light Kali developer documentation, package guidance, APIs, validation, and publishing resources.",
      "url": "/developer/"
    },
    {
      "name": "Documentation",
      "short_name": "Docs",
      "description": "Read Light Kali documentation, architecture notes, Linux basics, and project guides.",
      "url": "/docs/"
    },
    {
      "name": "Packages",
      "short_name": "Packages",
      "description": "Explore the Light Kali modular package ecosystem and capability areas.",
      "url": "/packages/"
    },
    {
      "name": "Web OS",
      "short_name": "Web OS",
      "description": "Learn how the Light Kali web-first operating environment is structured.",
      "url": "/web-os/"
    },
    {
      "name": "Wallpapers",
      "short_name": "Wallpapers",
      "description": "Browse the Light Kali 2026 wallpaper collection.",
      "url": "/wallpapers/"
    },
    {
      "name": "Changelog",
      "short_name": "Updates",
      "description": "View Light Kali project updates, releases, and changes.",
      "url": "/changelog/"
    }
  ],
  "related_applications": [],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}